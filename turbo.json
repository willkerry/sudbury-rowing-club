{
  "$schema": "https://turbo.build/schema.json",
  "agentGuidance": false,
  "concurrency": "12",
  "globalDependencies": ["**/.env.*local"],
  "globalPassThroughEnv": ["ENABLE_EXPERIMENTAL_COREPACK"],
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": ["^build", "generate"],
      "inputs": ["$TURBO_DEFAULT$", ".env.local"],
      "outputs": ["dist/**", "public/**"]
    },
    "deploy": {
      "cache": false,
      "dependsOn": ["build", "^build"],
      "outputs": [],
      "passThroughEnv": [
        "CLOUDFLARE_ACCOUNT_ID",
        "CLOUDFLARE_API_TOKEN",
        "SANITY_AUTH_TOKEN",
        "WRANGLER_SEND_METRICS"
      ]
    },
    "dev": {
      "cache": false,
      "dependsOn": ["generate"],
      "inputs": ["$TURBO_DEFAULT$", ".env.local"],
      "outputLogs": "new-only",
      "outputs": ["dist/**", "public/**"],
      "persistent": true
    },
    "generate": {
      "outputs": ["src/generated/**", "worker-configuration.d.ts"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "vendor/**",
        "scripts/**",
        "svgr.config.mjs"
      ]
    },
    "test": {
      "dependsOn": ["^build", "generate"],
      "outputs": []
    },
    "test:watch": {
      "outputs": []
    },
    "type-check": {
      "dependsOn": ["^build", "generate"],
      "inputs": ["**/*.ts", "**/*.tsx", "**/*.js", "**/*.jsx"]
    }
  }
}
