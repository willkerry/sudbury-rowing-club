# A generated secret for Payload
PAYLOAD_SECRET=

# Web app cache invalidation. After each collection/global write Payload
# POSTs { collection|global, slug?, id? } to ${REVALIDATE_URL}?secret=…
# The web app's /api/revalidate route then calls revalidateTag() for the
# matching payload:<...> tags. Leave blank in dev to disable.
REVALIDATE_URL=
REVALIDATE_SECRET=
