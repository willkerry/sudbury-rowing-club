---
import "inter-ui/inter-variable.css";
import "../styles/global.css";

interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <style is:inline>@layer base, archive;</style>
    <slot name="head" />
  </head>
  <body>
    <slot />
    <script>
      import { showReturnLinks } from "../lib/return-link.ts";

      showReturnLinks();
    </script>
  </body>
</html>
