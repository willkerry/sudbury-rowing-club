{
  "exclude": ["dist", "node_modules"],
  "extends": "@sudburyrc/tsconfig/base.json",
  "include": ["**/*.ts", "**/*.tsx"],
  "compilerOptions": {
    "allowJs": true,
    "declaration": false,
    "declarationMap": false,
    "incremental": true,
    "jsx": "preserve",
    "noEmit": true,
    "resolveJsonModule": true,
    "target": "ES2022"
  }
}
