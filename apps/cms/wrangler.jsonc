{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "compatibility_date": "2026-11-01",
  "name": "sudbury-sanity-cms",
  "preview_urls": false,
  "workers_dev": true,
  "assets": {
    "directory": "./dist/",
    "not_found_handling": "single-page-application"
  },
  "routes": [
    { "custom_domain": true, "pattern": "edit.sudburyrowingclub.org.uk" }
  ]
}
