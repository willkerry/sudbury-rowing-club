{
  "name": "@sudburyrc/weathericons",
  "version": "1.0.0",
  "license": "MIT",
  "main": "dist/index.mjs",
  "types": "dist/index.d.mts",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "types": "./dist/index.d.mts"
    }
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown",
    "generate": "svgr --config-file svgr.config.mjs --out-dir src/generated vendor/weather/svg && node scripts/generate-lookup.mjs",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "type-check": "tsc --noEmit"
  },
  "devDependencies": {
    "@sudburyrc/tsconfig": "workspace:*",
    "@svgr/cli": "^8.1.0",
    "@testing-library/react": "^16.3.3",
    "@types/react": "catalog:",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^26.1.0",
    "react": "catalog:",
    "react-dom": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "react": "^19.0.0"
  }
}
